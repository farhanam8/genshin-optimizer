+  const f = atkNow > 0 ? target.atk / atkNow : 0
+  const subCurve = def.subStat?.curve ?? 'GROW_CURVE_CRITICAL_301'
+  return {
+    mainStat: { ...def.mainStat, base: def.mainStat.base * f },
+    ascensionBonus: def.ascensionBonus.map((v) => v * f),
+    subStat:
