+  const lvl = rarity <= 2 ? 70 : 90
+  return {
+    atk:
+      mainStat.base * curves[mainStat.curve][lvl] +
+      (ascensionBonus['atk']?.at(-1) ?? 0),
+    subStat: subStat?.type,
+    subValue: subStat ? subStat.base * curves[subStat.curve][lvl] : 0,
+  }
