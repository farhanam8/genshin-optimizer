+            <WeaponName weaponKey={weapon.key} />
+          </Typography>
+          <Typography variant="caption" color="text.secondary" noWrap>
+            Lv. {weapon.level} · R{weapon.refinement}
+          </Typography>
+        </Box>
+      )}
+      {sets.length ? (
+        sets.map(({ setKey, count }) => (
