+                          alignItems="center"
+                        >
+                          <TextField
+                            select
+                            size="small"
+                            value={b.stat}
+                            onChange={(e) =>
+                              update(i, {
+                                bonuses: r.bonuses.map((x, k) =>
+                                  k === j
+                                    ? {
+                                        ...x,
+                                        stat: e.target
+                                          .value as CustomCharacterBuffStat,
+                                      }
+                                    : x
+                                ),
+                              })
+                            }
+                          >
+                            {customCharacterBuffStats.map((s) => (
+                              <MenuItem key={s} value={s}>
+                                {KeyMap.get(s)}
+                              </MenuItem>
+                            ))}
+                          </TextField>
+                          <TextField
+                            size="small"
+                            sx={{ width: 100 }}
+                            value={b.value}
+                            error={!Number.isFinite(num(b.value))}
+                            onChange={(e) =>
+                              update(i, {
+                                bonuses: r.bonuses.map((x, k) =>
+                                  k === j ? { ...x, value: e.target.value } : x
+                                ),
+                              })
+                            }
+                            InputProps={
+                              isPercentStat(b.stat)
+                                ? {
+                                    endAdornment: (
+                                      <InputAdornment position="end">
+                                        %
+                                      </InputAdornment>
+                                    ),
+                                  }
+                                : undefined
+                            }
+                          />
+                          <IconButton
+                            size="small"
+                            aria-label={t('customChar.buff.remove')}
+                            onClick={() =>
+                              update(i, {
+                                bonuses: r.bonuses.filter((_, k) => k !== j),
+                              })
+                            }
+                          >
+                            <DeleteForeverIcon fontSize="small" />
+                          </IconButton>
+                        </Box>
+                      ))}
+                      <Button
+                        size="small"
+                        startIcon={<AddIcon />}
+                        onClick={() =>
+                          update(i, {
+                            bonuses: [
+                              ...r.bonuses,
+                              { stat: 'critDMG_', value: '' },
+                            ],
+                          })
+                        }
+                      >
+                        {t('customChar.effect.addBonus')}
+                      </Button>
+                    </Box>
+                  </Grid>
+                )}
+                <Grid item xs={12}>
+                  <Typography
+                    variant="body2"
+                    color={matched.length ? 'text.secondary' : 'error'}
+                  >
+                    {matched.length
+                      ? t('customChar.effect.matched', {
+                          count: matched.length,
+                          names: matched.join(', '),
+                        })
+                      : t('customChar.effect.noMatch')}
+                  </Typography>
+                </Grid>
+                {invalid && (
+                  <Grid item xs={12}>
+                    <Typography variant="body2" color="error">
+                      {t('customChar.buff.invalid')}
+                    </Typography>
+                  </Grid>
+                )}
+              </Grid>
+            </CardContent>
+          </CardThemed>
+        )
+      })}
+      <Button
+        startIcon={<AddIcon />}
+        onClick={() => {
+          setRows([...rows, newEffectRow()])
+          setOpen(rows.length)
+        }}
+      >
+        {t('customChar.effect.add')}
+      </Button>
+    </Box>
+  )
+}
